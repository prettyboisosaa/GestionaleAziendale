# Quando parte il backup.
#
#   systemctl enable --now gestionale-backup.timer
#   systemctl list-timers gestionale-backup.timer     # quando tocchera' di nuovo
#
# systemd e non cron per una ragione pratica: cron comunica i fallimenti per
# posta, e su questo server la posta non va da nessuna parte - un backup che
# fallisce ogni notte lo farebbe in silenzio. Qui il fallimento resta uno
# stato che si puo' interrogare (`systemctl status gestionale-backup.service`)
# e il log sta nel journal insieme a tutto il resto.

[Unit]
Description=Backup notturno del database del gestionale

[Timer]
# Le 02:30: nessuno sta lavorando, e il dump dura secondi comunque.
OnCalendar=*-*-* 02:30:00

# Se il server era spento all'ora prevista, il backup parte al boot
# successivo invece di saltare la giornata. E' il motivo per cui backup.sh
# aspetta che il database sia sano prima di dumpare: al boot Docker c'e' gia'
# ma MySQL sta ancora salendo.
Persistent=true

# Qualche minuto di scarto. Qui serve a poco (c'e' un solo server), ma non
# costa niente e toglie il picco se un domani ne arriva un altro accanto.
RandomizedDelaySec=300

Unit=gestionale-backup.service

[Install]
WantedBy=timers.target
