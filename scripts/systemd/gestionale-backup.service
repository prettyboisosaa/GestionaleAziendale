# Il backup notturno del database. Non si avvia da se': lo lancia
# gestionale-backup.timer.
#
# Installazione (da /opt/gestionale, come root):
#   cp scripts/systemd/gestionale-backup.* /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now gestionale-backup.timer
#
# Se il progetto non sta in /opt/gestionale, va cambiato Environment= qui
# sotto, non lo script.

[Unit]
Description=Backup del database del gestionale
Documentation=file:/opt/gestionale/RILASCIO.md

# Senza Docker non c'e' niente da dumpare. Requires= e non Wants= perche' se
# il demone non parte, questo servizio deve fallire e dirlo, non riuscire a
# vuoto.
Requires=docker.service
After=docker.service

[Service]
Type=oneshot

# Lo script deve poter parlare con il socket di Docker.
User=root

Environment=PROGETTO=/opt/gestionale
Environment=DESTINAZIONE=/var/backups/gestionale
ExecStart=/opt/gestionale/scripts/backup.sh

# Il dump aspetta che il database sia sano (fino a 120s) e poi comprime: su un
# database di questa taglia sono secondi, ma il margine evita che un server
# lento al boot venga ucciso a meta' lavoro.
TimeoutStartSec=1800

# L'output va nel journal:
#   journalctl -u gestionale-backup.service
Nice=10
IOSchedulingClass=idle
