# Il modello del file `.env` che compose.prod.yml si aspetta accanto a se'.
#
#   cp .env.example .env     poi si riempiono i valori
#
# Questo file e' versionato (il .gitignore lo esclude dall'esclusione con
# `!.env.example`); `.env` no, e non deve diventarlo mai: contiene le
# credenziali del server vero.
#
# Niente valori di ripiego qui dentro. Un .env.example con dentro una password
# che funziona e' il modo in cui le password di esempio finiscono in
# produzione.

# --- Database ---------------------------------------------------------------
# La password dell'utente `gestionale`, quello con cui si connette il backend.
DB_PASSWORD=

# La password di root di MySQL. Serve al container per inizializzarsi e al
# proprio healthcheck; il backend non la usa.
MYSQL_ROOT_PASSWORD=

# --- Il primo amministratore -------------------------------------------------
# Lette SOLO se la tabella utente e' vuota, cioe' al primissimo avvio: il
# profilo di produzione non carica i dati di prova, quindi senza queste due
# righe il gestionale parte senza nessun utente e nessuno puo' entrare.
#
# La password deve rispettare le stesse regole di tutte le altre: almeno 8
# caratteri, almeno una cifra, almeno un carattere non alfanumerico. Se non le
# rispetta l'utente non viene creato e il log dice perche'.
#
# Dopo il primo accesso: cambiarla da «Profilo», poi svuotare ADMIN_PASSWORD
# qui e ricreare il container, cosi' il segreto non resta nell'ambiente del
# processo. Svuotare queste due righe e' previsto e lecito - a differenza di
# DB_PASSWORD e MYSQL_ROOT_PASSWORD, compose non le pretende: dal secondo
# avvio in poi la tabella utente non e' vuota e sono inerti comunque.
#
# Il terzo passo e' disattivare questa utenza del tutto, dall'elenco utenti e
# da un'ALTRA utenza amministratore (nessuno puo' disattivare se stesso): la
# riga resta, col suo badge, cosi' lo storico di chi ha creato cosa continua a
# leggersi.
ADMIN_EMAIL=
ADMIN_PASSWORD=
